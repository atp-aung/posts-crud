{
  "name": "posts-crud-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "css:build": "npx @tailwindcss/cli -i ./src/css/input.css -o ./public/css/output.css",
    "css:watch": "npx @tailwindcss/cli -i ./src/css/input.css -o ./public/css/output.css --watch",
    "dev": "npm-run-all --parallel watch css:watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2"
  }
}
